%%-----------------------------------------------------------------------------
%% Box Styles
%%-----------------------------------------------------------------------------

%% The appearance of all theorem-like boxes is controlled by the `style`
%% package option:
%%
%%   style=colorful  (default): colored background and left rule
%%   style=plain:                no background, border, or shaded rule

%% True right after a theorem-like, proof or solution box and false once a
%% paragraph begins. A proof or solution attaches to the box above it only
%% while the flag is true, so a line set between the two boxes (a sentence of
%% text, a Lean provenance mark) is never overlapped. Formats older than
%% 2021/06/01 lack the paragraph hook; the flag then stays true and every proof
%% attaches, as before.
\newif\ifdoc@afterbox
\IfFormatAtLeastTF{2021/06/01}{%
  \AddToHook{para/begin}{\global\doc@afterboxfalse}%
}{%
  \global\doc@afterboxtrue
}

%% Common plain style: tcolorbox remains invisible so that the environments
