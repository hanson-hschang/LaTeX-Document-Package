%%-----------------------------------------------------------------------------
%% Theorem-like Environments
%%-----------------------------------------------------------------------------


%% Numbering of the theorem-like environments, set by the package options
%%   numbering    : dependent   - all environments share one counter (default)
%%                  independent - each environment has its own counter
%%   numberbegin  : highest level printed in the number   (default: section)
%%   numberwithin : level whose new heading resets the counter (default: subsection)
%% numberbegin and numberwithin accept section, subsection, subsubsection, or none;
%% if either is none, the environments are numbered 1, 2, 3, ... through the whole document.
%% Each counter is reset at every level from section down to numberwithin, so it
%% also restarts at a new section before that section's first subsection.
\@namedef{doc@level@none}{0}
\@namedef{doc@level@section}{1}
\@namedef{doc@level@subsection}{2}
\@namedef{doc@level@subsubsection}{3}
\@namedef{doc@levelname@1}{section}
\@namedef{doc@levelname@2}{subsection}
\@namedef{doc@levelname@3}{subsubsection}

\newcommand{\doc@getlevel}[2]{% #1: macro to define, #2: option value
  \ifcsname doc@level@#2\endcsname
    \edef#1{\csname doc@level@#2\endcsname}%
  \else
    \PackageError{document}{Unknown numbering level `#2'}%
      {Use section, subsection, subsubsection, or none.}%
    \def#1{0}%
  \fi
}
\doc@getlevel{\doc@numbegin}{\doc@numberbegin}
\doc@getlevel{\doc@numwithin}{\doc@numberwithin}

\ifnum\doc@numbegin>\doc@numwithin\relax
  \ifnum\doc@numwithin>0\relax
    \PackageError{document}{numberbegin=\doc@numberbegin\space is deeper than
      numberwithin=\doc@numberwithin}%
      {numberbegin must be the same level as numberwithin or higher.
       Plain numbers are used instead.}%
  \fi
\fi

\ifnum\doc@numbegin=0\relax\def\doc@numwithin{0}\fi
\ifnum\doc@numbegin>\doc@numwithin\relax\def\doc@numwithin{0}\fi

\ifdefstring{\doc@numbering}{dependent}{}{%
  \ifdefstring{\doc@numbering}{independent}{}{%
    \PackageError{document}{Unknown numbering `\doc@numbering'}%
      {Use dependent or independent. dependent is used instead.}%
    \def\doc@numbering{dependent}%
  }%
}

%% Apply the reset levels and the printed format to the counter of
%% environment #1
\newcommand{\doc@setupcounter}[1]{%
  \ifnum\doc@numwithin=0\relax
    % Plain numbers
    \@namedef{thetcb@cnt@#1}{\arabic{tcb@cnt@#1}}%
  \else
    % Reset at every level from section down to numberwithin
    \@tempcnta=\@ne
    \loop
      \edef\doc@tmplevel{\csname doc@levelname@\the\@tempcnta\endcsname}%
      \counterwithin*{tcb@cnt@#1}{\doc@tmplevel}%
    \ifnum\@tempcnta<\doc@numwithin\relax
      \advance\@tempcnta\@ne
    \repeat
    % Print the levels from numberbegin down to numberwithin
    \def\doc@numformat{}%
    \@tempcnta=\doc@numbegin\relax
    \loop
      \edef\doc@numformat{\unexpanded\expandafter{\doc@numformat}%
        \noexpand\arabic{\csname doc@levelname@\the\@tempcnta\endcsname}.}%
    \ifnum\@tempcnta<\doc@numwithin\relax
      \advance\@tempcnta\@ne
    \repeat
    \expandafter\edef\csname thetcb@cnt@#1\endcsname{%
      \unexpanded\expandafter{\doc@numformat}\noexpand\arabic{tcb@cnt@#1}}%
  \fi
}

%% Declare a theorem-like environment: \doc@newtheorem{name}{Display}{box}{prefix}
%% Definition always owns a counter; with numbering=dependent the others use it.
\newcommand{\doc@newtheorem}[4]{%
  \ifboolexpr{test {\ifdefstring{\doc@numbering}{independent}}
               or test {\ifstrequal{#1}{definition}}}{%
    \newtcbtheorem{#1}{#2}{#3}{#4}%
    \doc@setupcounter{#1}%
  }{%
    \newtcbtheorem[use counter from=definition]{#1}{#2}{#3}{#4}%
  }%
}

%% Definitions
\doc@newtheorem{definition}{Definition}{thmgreenbox}{def}

%% Assumptions
\doc@newtheorem{assumption}{Assumption}{thmorangebox}{asm}

%% Conjectures
\doc@newtheorem{conjecture}{Conjecture}{thmpurplebox}{conj}

%% Hypotheses
