%% Load biblatex if not already loaded. The bibstyle option takes any biblatex
%% style (e.g. ieee, apa), or plainnat for the reference list of PMLR/JMLR
%% papers (natbib with plainnat).
\ifdefstring{\doc@bibstyle}{plainnat}{%
  %% plainnat: author-year citations; the entries follow BibTeX's plain style
  %% (full names, plain titles, year at the end), sorted by name, year, title.
  \@ifpackageloaded{biblatex}{}{%
    \RequirePackage[
      backend=biber,
      bibstyle=trad-plain,
      citestyle=authoryear,
      sorting=nyt,
      maxcitenames=2,
      maxbibnames=99,
      uniquename=false,
      uniquelist=false,
    ]{biblatex}
  }
  %% Unnumbered list with a hanging indent, as natbib sets it: the second and
  %% later lines are indented by 1em, and entries are separated by
  %% \itemsep + \parsep of a first-level list.
  \defbibenvironment{bibliography}
    {\list{}{%
       \setlength{\leftmargin}{\bibhang}%
       \setlength{\itemindent}{-\leftmargin}%
       \setlength{\itemsep}{\bibitemsep}%
       \setlength{\parsep}{\bibparsep}}}
    {\endlist}
    {\item}
  \setlength{\bibhang}{1em}
  \setlength{\bibparsep}{0pt}
  {\@listi \global\bibitemsep\itemsep \global\advance\bibitemsep\parsep}
  %% Comma between name and year in citations, as natbib: (Nordby et al., 2026)
  \renewcommand*{\nameyeardelim}{\addcomma\space}
  %% As natbib's list: stretch interword spaces rather than let an unbreakable
  %% item (e.g. arXiv:1610.01644) run into the margin, and avoid single lines of
  %% an entry at the top or bottom of a page.
  \AtBeginBibliography{\sloppy\clubpenalty4000\widowpenalty4000}
}{%
  \@ifpackageloaded{biblatex}{}{%
    \RequirePackage[backend=biber, style=\doc@bibstyle]{biblatex}
  }

  %% Square brackets for citations
  \renewcommand*{\mkbibparens}[1]{%
    \bibopenbracket#1\bibclosebracket%
  }
}


%%=============================================================================
%% NUMBERING STATE (used by the theorem environments and \setnumbering)
%%=============================================================================

%% Theorem-like environments and their counters, registered as they are
%% declared; \setnumbering resets and restores them.
\ExplSyntaxOn
\clist_new:N \g__doc_num_thmenvs_clist
\clist_new:N \g__doc_num_thmcounters_clist
\cs_new_protected:Npn \doc@registertheorem #1
  {
    % stored as a string, to match key names given to \setnumbering
    \clist_gput_right:Nx \g__doc_num_thmenvs_clist { \tl_to_str:n {#1} }
    \clist_gput_right:Nx \g__doc_num_thmcounters_clist
      { \exp_args:Nv \tl_to_str:n { tcb@cnt@#1 } }
    \clist_gremove_duplicates:N \g__doc_num_thmcounters_clist
  }
\ExplSyntaxOff

%% Section-level parts of a theorem number (expandable, so they work in \label
%% and \ref). While \setnumbering is in effect, the section part is the one
%% given to it; the subsection parts are always the (real) subsection and
%% subsubsection counters, which \setnumbering sets and later restores.
\newif\ifdoc@fakenum
\newcounter{doc@fakesection}
\def\doc@numpart#1{%
  \csname doc@\ifdoc@fakenum fake\else real\fi part@#1\endcsname}
\def\doc@realpart@section{\thesection}
\def\doc@realpart@subsection{\arabic{subsection}}
\def\doc@realpart@subsubsection{\arabic{subsubsection}}
\def\doc@fakepart@section{\number\value{doc@fakesection}}
\def\doc@fakepart@subsection{\arabic{subsection}}
\def\doc@fakepart@subsubsection{\arabic{subsubsection}}

