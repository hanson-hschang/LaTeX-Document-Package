  \ooalign{%
    \hfil\ding{111}\hfil\cr
    \hfil\raisebox{0.225em}{\scalebox{0.5}{\!\ding{220}}}\hfil\cr
  }%
}
\newcommand{\checkliststar}{%
  \ooalign{%
    \hfil\ding{111}\hfil\cr
    \hfil\raisebox{0.2em}{\scalebox{0.6}{\!\ding{86}}}\hfil\cr
  }%
}
\newcommand{\checklistquestion}{%
  \ooalign{%
    \hfil\ding{111}\hfil\cr
    \hfil\raisebox{0.225em}{\scalebox{0.5}{\!\textbf{\textsf{?}}}}\hfil\cr
  }%
}


% Define checklist as an itemize-like environment.
% Only the label is changed; spacing and margins follow itemize.
\newlist{checklist}{itemize}{1}
\setlist[checklist]{
  label=\checklistempty,
}


% Helper command for individual item states

\ExplSyntaxOn

\AtBeginEnvironment{checklist}
{
  \let\originalItem\item

  \RenewDocumentCommand{\item}{o}
  {
    \IfNoValueTF{#1}
    {
      \originalItem[\checklistempty]
    }
    {
      \str_case:nnF {#1}
      {
        {v} {\originalItem[\checklistcheck]}
        {x} {\originalItem[\checklistcross]}
        {?} {\originalItem[\checklistquestion]}
        {>} {\originalItem[\checklistongoing]}
        {*} {\originalItem[\checkliststar]}
      }
      {
        \originalItem[#1]
      }
    }
  }
}

\ExplSyntaxOff
%%=============================================================================
%% END OF PACKAGE
%%=============================================================================

\endinput
