%% Fixed number for one theorem-like box, given among the box options:
%%   \begin{proposition}[number=2.1.1]{Title}{label}
%% The box shows 2.1.1 in its title and in \ref, and does not advance the
%% counter, so the automatic numbers of the other boxes continue as if it
%% were not there. Everything stays local to the box.
%%
%% A theorem box reads the user's options first and sets up its counter
%% afterwards (\letcs\tcbcounter{...}, \letcs\thetcbcounter{...},
%% \stepcounter{\tcbcounter}). The key therefore intercepts that one
%% \stepcounter of the box's own counter: instead of stepping, it sets the
%% fixed number. Any other \stepcounter passes through unchanged.
\tcbset{
  number/.code={%
    \let\doc@tcb@stepcounter\stepcounter
    \def\stepcounter##1{%
      \edef\doc@tcb@arg{##1}% the box passes \tcbcounter itself
      \ifx\doc@tcb@arg\tcbcounter
        \let\stepcounter\doc@tcb@stepcounter
        \expandafter\def\csname the\doc@tcb@arg\endcsname{#1}%
        \expandafter\def\csname theH\doc@tcb@arg\endcsname{fixed.#1}%
        \def\thetcbcounter{#1}%
      \else
        \doc@tcb@stepcounter{##1}%
      \fi
    }%
  },
}

