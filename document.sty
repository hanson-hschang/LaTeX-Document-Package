%% Appendix: section-page numbering (A-1, A-2, B-1, ...). Each appendix
%% section is numbered from the page where it starts, and a page where a new
%% appendix section starts takes that section's letter. The appendix itself
%% starts on a new page; its sections do not.
%%
%% TeX may read the start of the next section before the current page is
%% output, so the letter cannot be taken from the section counter at that time.
%% Instead, as with \label/\pageref, each appendix section records the
%% (absolute) page it starts on in the .aux file, and \thepage is computed from
%% those records; a change in them asks for a rerun ("Label(s) may have
%% changed"). The page counter itself keeps running, so every page stays unique.
\newif\ifdoc@inappendix
\newif\ifdoc@apx@endread
\AtEndDocument{\global\doc@apx@endreadtrue}
%% .aux record: \doc@apxstart{<section number>}{<absolute page>}. Read at
%% \begin{document} to define the start pages, and again at \end{document} to
%% detect changes.
\newcommand{\doc@apxstart}[2]{%
  \ifdoc@apx@endread
    \ifcsname doc@apx@start@#1\endcsname
      \ifnum\csname doc@apx@start@#1\endcsname=#2\relax\else\@tempswatrue\fi
    \else
      \@tempswatrue
    \fi
  \else
    \expandafter\xdef\csname doc@apx@start@#1\endcsname{#2}%
  \fi
}
%% Called at every numbered heading, after the heading has been typeset;
%% records the start page of an appendix section (level 1). The \write is
%% expanded when its page is output.
\newcommand{\doc@apx@abspage}{\number\c@page}
\newcommand{\doc@appendixsection}[1]{%
  \ifdoc@inappendix
    \ifnum#1=\@ne
      %% The section number is expanded now; the page number only when the
      %% page is output (\protected@write expands its text at once, so
      %% \doc@apx@abspage is kept as \relax until then).
      \begingroup
        \edef\x{\endgroup
          \noexpand\protected@write\noexpand\@auxout
            {\let\noexpand\doc@apx@abspage\relax}{%
            \noexpand\string\noexpand\doc@apxstart
            {\number\c@section}{\noexpand\doc@apx@abspage}}}%
      \x
    \fi
  \fi
}
%% \@sect typesets numbered sectioning headings; its #2 is the level
%% (1: section). hyperref and nameref (loaded above) wrap the class's \@sect,
%% which ends up as \NR@sect; whichever of \NR@sect, \H@old@sect, \@sect
%% contains \@xsect{#5} is patched. The record goes just before \@xsect,
%% i.e. right after the heading's line, its header mark, and its table-of-
%% contents entry, where no page break can fall; recorded before the heading,
%% it could stay on the previous page when the heading moves to the next one.
%% (The patches are issued at the top level: etoolbox cannot apply a patch
%% containing # from inside another macro. Only the layer holding \@xsect{#5}
%% matches; the others, or undefined ones, fail silently.)
\newif\ifdoc@sectpatched
\patchcmd{\NR@sect}{\@xsect{#5}}{\doc@appendixsection{#2}\@xsect{#5}}%
  {\doc@sectpatchedtrue}{}
\patchcmd{\H@old@sect}{\@xsect{#5}}{\doc@appendixsection{#2}\@xsect{#5}}%
  {\doc@sectpatchedtrue}{}
\patchcmd{\@sect}{\@xsect{#5}}{\doc@appendixsection{#2}\@xsect{#5}}%
  {\doc@sectpatchedtrue}{}
\ifdoc@sectpatched\else
  \PackageWarning{document}{Could not set appendix page numbering}
\fi
%% \thepage in the appendix (expandable): find the last section n that starts
%% on or before this page, and print <letter of n>-<pages since its start + 1>.
%% Section 1 (A) counts from the first appendix page.
\def\doc@apx@find#1{%
  \ifcsname doc@apx@start@\number\numexpr#1+1\endcsname
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi
  {\doc@apx@cmp{#1}}%
  {\doc@apx@out{#1}}%
}
\def\doc@apx@cmp#1{%
  \ifnum\c@page<\csname doc@apx@start@\number\numexpr#1+1\endcsname\relax
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi
  {\doc@apx@out{#1}}%
  {\expandafter\doc@apx@find\expandafter{\number\numexpr#1+1}}%
}
\def\doc@apx@out#1{%
  \@Alph{#1}-\number\numexpr\c@page-%
    \ifnum#1=\@ne\doc@apx@base\else\csname doc@apx@start@#1\endcsname\fi+1\relax
}

\NewDocumentCommand{\setappendix}{O{.}}{%
  \renewcommand{\doc@directory}{#1}%
  \clearpage
  \appendix%
  \xdef\doc@apx@base{\the\c@page}%
  \renewcommand{\thepage}{\doc@apx@find{1}}%
  \global\doc@inappendixtrue
  %% In an article, \appendixpage sets an empty header mark (\markboth{}{}),
  %% which would blank the header of the first appendix page; skip that mark
  %% so the page is headed by its first appendix section. (Not in a group:
  %% \appendixpage's \@afterheading must stay in effect.)
  \let\doc@markboth\markboth
  \let\markboth\@gobbletwo
  \appendixpage{}%
  \let\markboth\doc@markboth
}

\newcommand{\addcontent}[1]{%
  \input{\doc@directory/#1}%
}

