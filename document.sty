%%=============================================================================
%% \setnumbering: NUMBER AS IN ANOTHER DOCUMENT
%%=============================================================================

%% \setnumbering[<key>=<value>, ...] numbers what follows as if it were in a
%% given section of another document (e.g. a paper being rewritten):
%%   \setnumbering[section=3]
%% means "we are now in Section 3": equations (3.1), (3.2), ..., the next
%% \subsection is 3.1, and boxes after it are Lemma 3.1.1, Remark 3.1.1, ...
%% The numbering then runs on like LaTeX's own: the next \section is
%% Section 4, with (4.1), 4.1, Lemma 4.1.1, ..., until \setnumbering[reset].
%% Keys (all optional):
%%   section, subsection, subsubsection
%%       the section we are in, as LaTeX's counters hold it: section=3,
%%       subsection=1 means "in 3.1" (boxes 3.1.n; a following \subsection is
%%       3.2). Giving a level resets the levels below it to 0, as LaTeX does;
%%       giving section also restarts the equations, and giving a level the
%%       theorem-like boxes are numbered within (option numberwithin) restarts
%%       the boxes. Real \section, \subsection and \subsubsection headings then
%%       step and print these numbers (e.g. 4, 3.1), in the text, the table of
%%       contents, and the running header.
%%   equation, <theorem-like environment> (lemma, remark, ...), <any LaTeX
%%   counter> (figure, table, ...)
%%       the number of the next item ("start at"); stored as LaTeX does, i.e.
%%       the counter is set to <value> - 1 and stepped by the next item.
%%   reset
%%       return to the document's real numbering: section, equation and box
%%       numbers are real again, and counters changed by \setnumbering get
%%       their real values back (counters that restart with each section, such
%%       as subsection and the boxes, only if no real \section came in between).
%%       Only reset ends the numbering set by \setnumbering.
%% The real section counter keeps running underneath, so appendix page
%% numbers (A-1, ...) and the real section letters that follow a reset are
%% unaffected. Settings are global, like \setcounter. Items numbered this way
%% get their own hyperref link targets, so they cannot collide with real ones.
\ExplSyntaxOn
\tl_new:N \l__doc_num_section_tl
\tl_new:N \l__doc_num_subsection_tl
\tl_new:N \l__doc_num_subsubsection_tl
\bool_new:N \l__doc_num_reset_bool
\prop_new:N \l__doc_num_keys_prop
\prop_new:N \l__doc_num_counters_prop
\prop_new:N \g__doc_num_saved_prop
\tl_new:N \l__doc_num_counter_tl
\tl_new:N \g__doc_num_realsection_tl

\msg_new:nnn { document } { setnumbering-unknown-key }
  {
    Unknown~key~'#1'~in~\token_to_str:N \setnumbering.~
    Valid~keys:~section,~subsection,~subsubsection,~reset,~equation,~
    a~theorem-like~environment~(lemma,~remark,~...),~
    or~any~LaTeX~counter~(figure,~table,~...).
  }
\msg_new:nnn { document } { setnumbering-no-section }
  {
    '#1'~in~\token_to_str:N \setnumbering\ needs~a~section:~give~
    section=...~as~well~(or~earlier).
  }
\msg_new:nnn { document } { setnumbering-shared-counter }
  {
    With~numbering=dependent,~'#1'~shares~one~counter~with~all~
    theorem-like~environments,~so~#1=...~in~\token_to_str:N \setnumbering\
    also~moves~the~others.
  }

\keys_define:nn { document / setnumbering }
  {
    section       .tl_set:N   = \l__doc_num_section_tl ,
    subsection    .tl_set:N   = \l__doc_num_subsection_tl ,
    subsubsection .tl_set:N   = \l__doc_num_subsubsection_tl ,
    reset         .bool_set:N = \l__doc_num_reset_bool ,
    reset         .default:n  = true ,
    unknown       .code:n     =
      \prop_put:NVn \l__doc_num_keys_prop \l_keys_key_str {#1} ,
  }

%% Remember the real value of a counter (once), so reset can restore it.
\cs_new_protected:Npn \__doc_num_save:n #1
  {
    \prop_if_in:NnF \g__doc_num_saved_prop {#1}
      { \prop_gput:Nnx \g__doc_num_saved_prop {#1} { \int_use:c { c@#1 } } }
  }
%% Give counter #1 its own link targets while the numbering is in effect.
\cs_new_protected:Npn \__doc_num_fake_theH:n #1
  {
    \cs_if_exist:cF { doc@real@theH#1 }
      { \cs_gset_eq:cc { doc@real@theH#1 } { theH#1 } }
    \cs_gset:cpn { theH#1 }
      { \cs_if_exist_use:c { theHsection } .setnumbering. \use:c { the#1 } }
  }
\cs_new_protected:Npn \__doc_num_real_theH:n #1
  {
    \cs_if_exist:cT { doc@real@theH#1 }
      {
        \cs_gset_eq:cc { theH#1 } { doc@real@theH#1 }
        \cs_undefine:c { doc@real@theH#1 }
      }
  }
%% Switch the section-level parts to the given ones.
\cs_new_protected:Npn \__doc_num_activate:
  {
    \legacy_if:nF { doc@fakenum }
      {
        \__doc_num_save:n { equation }
        \__doc_num_save:n { subsection }
        \__doc_num_save:n { subsubsection }
        \clist_map_function:NN \g__doc_num_thmcounters_clist \__doc_num_save:n
        \cs_gset_eq:NN \doc@real@theequation \theequation
        \cs_gset:Npn \theequation
          { \int_use:N \c@doc@fakesection . \arabic { equation } }
        \tl_gset:Nx \g__doc_num_realsection_tl { \int_use:N \c@section }
        % \thesubsection, \thesubsubsection, and their link names are built on
        % \thesection and \theHsection, so these two carry the substitution.
        \cs_gset_eq:NN \doc@real@thesection \thesection
        \cs_gset:Npn \thesection { \int_use:N \c@doc@fakesection }
        \cs_gset_eq:NN \doc@real@theHsection \theHsection
        \cs_gset:Npn \theHsection
          { \doc@real@theHsection .setnumbering. \int_use:N \c@doc@fakesection }
        \__doc_num_fake_theH:n { equation }
        \clist_map_function:NN \g__doc_num_thmcounters_clist \__doc_num_fake_theH:n
        \legacy_if_gset_true:n { doc@fakenum }
      }
  }
%% Back to the real numbering.
\cs_new_protected:Npn \__doc_num_reset:
  {
    % Counters that restart with each section keep their values when a real
    % \section came in between; the others get their saved values back.
    \bool_if:nTF
      {
        \legacy_if_p:n { doc@fakenum }
        && ! \int_compare_p:nNn { \c@section } = { \g__doc_num_realsection_tl }
      }
      {
        \prop_map_inline:Nn \g__doc_num_saved_prop
          {
            \bool_set_false:N \l_tmpa_bool % true: restarts with each section
            \str_if_eq:nnT {##1} { subsection } { \bool_set_true:N \l_tmpa_bool }
            \str_if_eq:nnT {##1} { subsubsection } { \bool_set_true:N \l_tmpa_bool }
            \int_compare:nNnT { \cs_if_exist_use:NF \doc@numwithin { 0 } } > { 0 }
              {
                \clist_if_in:NnT \g__doc_num_thmcounters_clist {##1}
                  { \bool_set_true:N \l_tmpa_bool }
              }
            \bool_if:NF \l_tmpa_bool { \setcounter {##1} {##2} }
          }
      }
      { \prop_map_inline:Nn \g__doc_num_saved_prop { \setcounter {##1} {##2} } }
    \prop_gclear:N \g__doc_num_saved_prop
    \legacy_if:nT { doc@fakenum }
      {
        \cs_gset_eq:NN \theequation \doc@real@theequation
        \cs_gset_eq:NN \thesection \doc@real@thesection
        \cs_gset_eq:NN \theHsection \doc@real@theHsection
        \__doc_num_real_theH:n { equation }
        \clist_map_function:NN \g__doc_num_thmcounters_clist \__doc_num_real_theH:n
        \legacy_if_gset_false:n { doc@fakenum }
      }
  }
\cs_new_protected:Npn \__doc_num_reset_boxes:n #1
  {
    \int_compare:nNnT { #1 } > { 0 }
      {
        \int_compare:nNnF
          { \cs_if_exist_use:NF \doc@numwithin { 0 } } < { #1 }
          {
            \clist_map_inline:Nn \g__doc_num_thmcounters_clist
              { \setcounter {##1} {0} }
          }
      }
  }
\cs_new_protected:Npn \__doc_num_set_level:nn #1#2
  {
    \str_if_eq:nnTF {#1} { section }
      { \setcounter { doc@fakesection } {#2} }
      { \setcounter {#1} {#2} }
  }

\NewDocumentCommand \setnumbering { O{} }
  {
    \group_begin:
      \tl_clear:N \l__doc_num_section_tl
      \tl_clear:N \l__doc_num_subsection_tl
      \tl_clear:N \l__doc_num_subsubsection_tl
      \bool_set_false:N \l__doc_num_reset_bool
      \prop_clear:N \l__doc_num_keys_prop
      \prop_clear:N \l__doc_num_counters_prop
      \keys_set:nn { document / setnumbering } {#1}
      \bool_if:NT \l__doc_num_reset_bool { \__doc_num_reset: }
      % Map the remaining keys to LaTeX counters.
      \prop_map_inline:Nn \l__doc_num_keys_prop
        {
          \clist_if_in:NnTF \g__doc_num_thmenvs_clist {##1}
            {
              \tl_set:Nx \l__doc_num_counter_tl { \use:c { tcb@cnt@##1 } }
              \str_if_eq:VnF \doc@numbering { independent }
                {
                  \str_if_eq:nnF {##1} { definition }
                    { \msg_warning:nnn { document } { setnumbering-shared-counter } {##1} }
                }
              \prop_put:NVn \l__doc_num_counters_prop \l__doc_num_counter_tl {##2}
            }
            {
              \cs_if_exist:cTF { c@##1 }
                { \prop_put:Nnn \l__doc_num_counters_prop {##1} {##2} }
                { \msg_error:nnn { document } { setnumbering-unknown-key } {##1} }
            }
        }
      % Section levels: a level resets the levels below it, as in LaTeX.
      \tl_if_empty:NTF \l__doc_num_section_tl
        {
          \tl_if_empty:NF \l__doc_num_subsection_tl
            {
              \legacy_if:nTF { doc@fakenum }
                {
                  \__doc_num_set_level:nn { subsection } { \l__doc_num_subsection_tl }
                  \tl_if_empty:NTF \l__doc_num_subsubsection_tl
                    { \__doc_num_set_level:nn { subsubsection } { 0 } }
                    { \__doc_num_set_level:nn { subsubsection } { \l__doc_num_subsubsection_tl } }
                  \__doc_num_reset_boxes:n { 2 }
                }
                { \msg_error:nnn { document } { setnumbering-no-section } { subsection } }
            }
          \tl_if_empty:NF \l__doc_num_subsubsection_tl
            {
              \tl_if_empty:NT \l__doc_num_subsection_tl
                {
                  \legacy_if:nTF { doc@fakenum }
                    {
                      \__doc_num_set_level:nn { subsubsection } { \l__doc_num_subsubsection_tl }
                      \__doc_num_reset_boxes:n { 3 }
                    }
                    { \msg_error:nnn { document } { setnumbering-no-section } { subsubsection } }
                }
            }
        }
        {
          \__doc_num_activate:
          \__doc_num_set_level:nn { section } { \l__doc_num_section_tl }
          \tl_if_empty:NTF \l__doc_num_subsection_tl
            { \__doc_num_set_level:nn { subsection } { 0 } }
            { \__doc_num_set_level:nn { subsection } { \l__doc_num_subsection_tl } }
          \tl_if_empty:NTF \l__doc_num_subsubsection_tl
            { \__doc_num_set_level:nn { subsubsection } { 0 } }
            { \__doc_num_set_level:nn { subsubsection } { \l__doc_num_subsubsection_tl } }
          \setcounter { equation } { 0 }
          \__doc_num_reset_boxes:n { 1 }
        }
      % Explicit counters: "start at" <value>, stored as LaTeX does.
      \prop_map_inline:Nn \l__doc_num_counters_prop
        {
          \__doc_num_save:n {##1}
          \setcounter {##1} { \int_eval:n { ##2 - 1 } }
        }
    \group_end:
  }

%% While \setnumbering is in effect, a numbered \section steps the given
%% section number and restarts the equations (subsections and boxes restart
%% with the real section counter, as usual).
\cs_new_protected:Npn \doc@setnumbering@sectionstep #1
  {
    \legacy_if:nT { doc@fakenum }
      {
        \str_if_eq:nnT {#1} { section }
          {
            \stepcounter { doc@fakesection }
            \setcounter { equation } { 0 }
          }
      }
  }
\ExplSyntaxOff
%% Called in \@sect just before a numbered heading steps its counter. As for
%% the appendix record, whichever of \NR@sect, \H@old@sect, \@sect holds the
%% class's code is patched (at the top level, because of the #).
\newif\ifdoc@secstep@patched
\patchcmd{\NR@sect}{\refstepcounter{#1}}%
  {\doc@setnumbering@sectionstep{#1}\refstepcounter{#1}}%
  {\doc@secstep@patchedtrue}{}
\patchcmd{\H@old@sect}{\refstepcounter{#1}}%
  {\doc@setnumbering@sectionstep{#1}\refstepcounter{#1}}%
  {\doc@secstep@patchedtrue}{}
\patchcmd{\@sect}{\refstepcounter{#1}}%
  {\doc@setnumbering@sectionstep{#1}\refstepcounter{#1}}%
  {\doc@secstep@patchedtrue}{}
\ifdoc@secstep@patched\else
  \PackageWarning{document}{Could not let \protect\section\space follow
    \protect\setnumbering}
\fi

