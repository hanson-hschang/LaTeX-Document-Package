%%-----------------------------------------------------------------------------
%% Proof and Solution Environments
%%-----------------------------------------------------------------------------

%% Vertical space before a proof or solution. The colorful style pulls the box
%% up to attach it to the preceding box when it follows one directly (see
%% \ifdoc@afterbox), and otherwise leaves a small gap below the preceding line,
%% since pulling up would overlap that line; the plain style keeps the normal gap.
\ifdefstring{\doc@style}{plain}{%
  \newcommand{\doc@proofskip}{\removelastskip}%
}{%
  \newcommand{\doc@proofskip}{%
    \ifdoc@afterbox
      \removelastskip\vspace{-\baselineskip+2mm}%
    \else
      \vspace{2mm}%
    \fi
  }%
}

%% Proof tcolorbox style
\ifdefstring{\doc@style}{plain}{%
  \tcbset{
    proofstyle/.style={
      doc@plainbox,
      top=-0.5\baselineskip,
      fontupper=\upshape,
      fonttitle=\itshape,
      before skip=0pt,
      attach title to upper={\quad},
    }
  }%
}{%
  \tcbset{
    proofstyle/.style={
      enhanced,
      breakable,
      colback=RawSienna!2,
      colframe=RawSienna,
      boxrule=-0.1pt,
      leftrule=2pt,
      sharp corners,
      before skip=0pt,
      left=2mm,
      right=2mm,
      fonttitle=\bfseries\sffamily,
      coltitle=RawSienna!70!black,
      attach title to upper={\quad},
      after app={\global\doc@afterboxtrue},
    }
  }%
}

%% Custom proof environment
\renewenvironment{proof}[1][\proofname]{%
  \par\doc@proofskip%
  \pushQED{\null\hfill\(\square\)}%
  \begin{tcolorbox}[
    proofstyle, 
    title=#1, 
  ]%
}{%
  \popQED%
  \end{tcolorbox}%
}

%% Solution tcolorbox style
\ifdefstring{\doc@style}{plain}{%
  \tcbset{
    solutionstyle/.style={
      doc@plainbox,
      top=-0.5\baselineskip,
      fontupper=\upshape,
      fonttitle=\itshape,
      before skip=0pt,
      attach title to upper={\quad},
    }
  }%
}{%
  \tcbset{
    solutionstyle/.style={
      enhanced,
      breakable,
      colback=NavyBlue!2,
      colframe=NavyBlue,
      boxrule=-0.01pt,
      leftrule=2pt,
      sharp corners,
      before skip=0pt,
      left=2mm,
      right=2mm,
      fonttitle=\bfseries\sffamily,
      coltitle=NavyBlue!70!black,
      attach title to upper={\quad},
      after app={\global\doc@afterboxtrue},
    }
  }%
}

%% Solution environment
\newenvironment{solution}[1][Solution]{%
  \par\doc@proofskip%
  \pushQED{\null\hfill\(\blacksquare\)}%
  \begin{tcolorbox}[
    solutionstyle, 
    title=#1, 
  ]%
}{%
  \popQED%
  \end{tcolorbox}%
}

