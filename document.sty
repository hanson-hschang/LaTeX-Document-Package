%% Step heading inside a proof or solution, e.g. \step{\ref{item:part-one}} or
%% \step{Upper bound}. A step always starts a new paragraph, preceded by a
%% \smallskip, whether or not a blank line precedes it in the source.
%% The label is a run-in heading, like \paragraph (1em of space before the
%% text that follows), but with the \smallskip instead of \paragraph's space
%% above; it adds no table-of-contents entry or header mark.
%% style=plain: the label is italic, like \emph.
%% style=colorful: the label is bold, like \paragraph.
\ifdefstring{\doc@style}{plain}{%
  \newcommand{\doc@stepfont}{\itshape}%
}{%
  \newcommand{\doc@stepfont}{\bfseries}%
}
\NewDocumentCommand{\step}{m}{%
  \par\smallskip
  \@startsection{paragraph}{4}{\z@}{\z@}{-1em}%
    {\normalfont\normalsize\doc@stepfont}*{#1}}

