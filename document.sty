%% Load biblatex if not already loaded. The bibstyle option takes any biblatex
%% style (e.g. ieee, apa), or plainnat for the reference list of PMLR/JMLR
%% papers (natbib with plainnat).
\ifdefstring{\doc@bibstyle}{plainnat}{%
  %% plainnat: author-year citations; the entries follow BibTeX's plain style
  %% (full names, plain titles, year at the end), sorted by name, year, title.
  \@ifpackageloaded{biblatex}{}{%
    \RequirePackage[
      backend=biber,
      bibstyle=trad-plain,
      citestyle=authoryear,
      sorting=nyt,
      maxcitenames=2,
      maxbibnames=99,
      uniquename=false,
      uniquelist=false,
    ]{biblatex}
  }
  %% Unnumbered list with a hanging indent, as natbib sets it: the second and
  %% later lines are indented by 1em, and entries are separated by
  %% \itemsep + \parsep of a first-level list.
  \defbibenvironment{bibliography}
    {\list{}{%
       \setlength{\leftmargin}{\bibhang}%
       \setlength{\itemindent}{-\leftmargin}%
       \setlength{\itemsep}{\bibitemsep}%
       \setlength{\parsep}{\bibparsep}}}
    {\endlist}
    {\item}
  \setlength{\bibhang}{1em}
  \setlength{\bibparsep}{0pt}
  {\@listi \global\bibitemsep\itemsep \global\advance\bibitemsep\parsep}
  %% Comma between name and year in citations, as natbib: (Nordby et al., 2026)
  \renewcommand*{\nameyeardelim}{\addcomma\space}
  %% As natbib's list: stretch interword spaces rather than let an unbreakable
  %% item (e.g. arXiv:1610.01644) run into the margin, and avoid single lines of
  %% an entry at the top or bottom of a page.
  \AtBeginBibliography{\sloppy\clubpenalty4000\widowpenalty4000}
}{%
  \@ifpackageloaded{biblatex}{}{%
    \RequirePackage[backend=biber, style=\doc@bibstyle]{biblatex}
  }

  %% Square brackets for citations
  \renewcommand*{\mkbibparens}[1]{%
    \bibopenbracket#1\bibclosebracket%
  }
}


