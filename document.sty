    colback=white,
    colframe=white,
    interior hidden,
    frame hidden,
    boxrule=0pt,
    leftrule=0pt,
    rightrule=0pt,
    toprule=0pt,
    bottomrule=0pt,
    sharp corners,
    boxsep=0pt,
    left=0pt,
    right=0pt,
    fonttitle=\bfseries\upshape,
    fontupper=\itshape,
    coltitle=black,
    attach title to upper={~},
    separator sign={},
    description delimiters={(}{)},
    description font=\mdseries\upshape,
    after app={\global\doc@afterboxtrue},
  },
%% Common colorful style
  doc@colorbox/.style={
    enhanced,
    breakable,
    colback=#1!5,
    colframe=#1,
    boxrule=-0.01pt,
    leftrule=2pt,
    sharp corners,
    left=2mm,
    right=2mm,
    fonttitle=\bfseries\sffamily,
